// EasyRunKlub - Prisma Schema
// Module 1: Core foundation tables (Users, Roles, Memberships, Wallets, Transactions)
// Module 3: Settings, dues, membership numbers, payment purpose

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// Enums
// ------------------------------------------------------------------

enum Role {
  MEMBER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  PENDING
  CANCELLED
  EXPIRED
  LAPSED // NEW: activated, but monthly dues are overdue past the grace period
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  PAYMENT
  REFUND
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

// NEW: what a payment is for, so the webhook knows how to process it
enum TransactionPurpose {
  ACTIVATION
  TOPUP
  DUES
  OTHER
}

// NEW
enum DuesStatus {
  DUE
  PAID
  WAIVED
}

// ------------------------------------------------------------------
// Auth
// ------------------------------------------------------------------

model User {
  id                    String    @id @default(cuid())
  name                  String?
  email                 String    @unique
  emailVerified         DateTime?
  image                 String?
  passwordHash          String?
  role                  Role      @default(MEMBER)
  phone                 String?
  dateOfBirth           DateTime?
  gender                Gender?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts    Account[]
  sessions    Session[]
  membership  Membership?
  wallet      Wallet?
  duesCharges DuesCharge[] // NEW
  auditLogs   AuditLog[]

  @@map("users")
}

// Auth.js adapter tables (kept minimal; we use JWT sessions by default,
// but these tables let us switch to database sessions or add OAuth
// providers later without a schema change).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ------------------------------------------------------------------
// Membership
// ------------------------------------------------------------------

model Membership {
  id               String           @id @default(cuid())
  userId           String           @unique
  membershipNumber String?          @unique // NEW: e.g. ERK-000001 (encoded in the QR code)
  status           MembershipStatus @default(PENDING)
  plan             String           @default("standard") // all members are equal; kept for compatibility
  startDate        DateTime?
  endDate          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("memberships")
}

// ------------------------------------------------------------------
// Wallet & Transactions
// (Schema is payment-gateway-ready: external reference + currency +
// status fields are in place even though no gateway is wired up yet.)
// ------------------------------------------------------------------

model Wallet {
  id       String @id @default(cuid())
  userId   String @unique
  balance  Int    @default(0) // stored in minor units (e.g. kobo/cents)
  currency String @default("NGN")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("wallets")
}

model Transaction {
  id       String            @id @default(cuid())
  walletId String
  type     TransactionType
  status   TransactionStatus @default(PENDING)
  amount   Int // minor units; positive value, sign implied by `type`
  currency String            @default("NGN")

  // NEW: why this payment exists. Null on older rows (treated as ACTIVATION).
  purpose TransactionPurpose?

  // Payment-gateway readiness (populated once a gateway is integrated)
  provider          String?
  providerReference String?
  metadata          Json?

  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallet     Wallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)
  duesCharge DuesCharge? // NEW

  @@unique([provider, providerReference])
  @@index([walletId])
  @@map("transactions")
}

// ------------------------------------------------------------------
// NEW: Admin-editable settings (activation fee, monthly dues, grace days)
// Values are stored as strings; money is in kobo.
// ------------------------------------------------------------------

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ------------------------------------------------------------------
// NEW: One row per member per billing month
// ------------------------------------------------------------------

model DuesCharge {
  id            String     @id @default(cuid())
  userId        String
  periodStart   DateTime // start of the billing month this charge covers
  dueDate       DateTime
  amount        Int // kobo, copied from settings when the charge is created
  status        DuesStatus @default(DUE)
  paidAt        DateTime?
  paidVia       String? // "wallet" | "paystack" | "admin"
  transactionId String?    @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@unique([userId, periodStart])
  @@index([status, dueDate])
  @@map("dues_charges")
}

// ------------------------------------------------------------------
// NEW: Record of admin actions (who changed what, when)
// ------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String // e.g. "settings.update"
  targetType String?
  targetId   String?
  details    Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}